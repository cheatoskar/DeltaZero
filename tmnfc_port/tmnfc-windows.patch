+static HMODULE g_self_module;
+
+/* GetEnvironmentVariableA, falling back to TMNFTracer.cfg (NAME=VALUE lines) next to this
+ * DLL, so the tracer can be injected into an already running game on Windows. */
+DWORD tracer_config(const char *name, char *out, DWORD size)
+{
+	char path[MAX_PATH], line[1024];
+	DWORD n = GetEnvironmentVariableA(name, out, size);
+	FILE *f;
+	char *slash;
+	size_t len = strlen(name);
+	if (n != 0 || g_self_module == NULL)
+		return n;
+	if (GetModuleFileNameA(g_self_module, path, sizeof(path)) == 0)
+		return 0;
+	slash = strrchr(path, '\\');
+	if (slash == NULL)
+		return 0;
+	strcpy(slash + 1, "TMNFTracer.cfg");
+	f = fopen(path, "r");
+	if (f == NULL)
+		return 0;
+	while (fgets(line, sizeof(line), f) != NULL) {
+		if (strncmp(line, name, len) == 0 && line[len] == '=') {
+			char *v = line + len + 1;
+			v[strcspn(v, "\r\n")] = '\0';
+			n = (DWORD)strlen(v);
+			if (n < size)
+				strcpy(out, v);
+			else
+				n = n + 1;
+			break;
+		}
+	}
+	fclose(f);
+	return n;
+}
+
